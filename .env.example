# Copy to .env and fill in. .env is gitignored and excluded from the Docker
# image. dawnwagesinfo/settings/deploy.py loads it with python-dotenv.

# Django
SECRET_KEY=
# Any non-empty value turns DEBUG on (including "False"). Leave empty for off.
DEBUG=1
ENVIRONMENT=local

# Aurora PostgreSQL (IAM auth: the password is a token generated with the AWS
# credentials below, so there is no DB password here).
HOST=
NAME=
DB_USER=
# Database port (defaults to 5432). Don't use PORT: that's the web server port.
DB_PORT=5432

# AWS credentials used to generate the database IAM token (and S3 if enabled).
# Locally, use an IAM Identity Center (SSO) profile from `aws configure sso`
# and sign in with `aws sso login --profile <name>`. The profile's permission
# set needs rds-db:connect for DB_USER.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
# Long-lived access keys: only where SSO isn't available (e.g. the server).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 media storage. Set to TRUE to store uploads in S3.
USE_S3=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
