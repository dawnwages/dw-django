{
  "name": "webpack-starter",
  "engines": {
    "npm": "=11.9.13",
    "node": "=24.14.0"
  },
  "version": "2.0.0",
  "description": "A light foundation for your next frontend project based on webpack.",
  "scripts": {
    "lint": "npm run lint:styles; npm run lint:scripts",
    "lint:styles": "stylelint src",
    "lint:scripts": "eslint src",
    "build": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.prod.js",
    "start": "webpack --watch --config webpack/webpack.config.dev.js --stats-children"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbkd/webpack-starter.git"
  },
  "keywords": [
    "webpack",
    "startkit",
    "frontend",
    "es6",
    "javascript",
    "webdev"
  ],
  "author": "webkid.io",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wbkd/webpack-starter/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.12.7",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.4",
    "eslint-webpack-plugin": "^6.0.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "node-sass": "^9.0.0",
    "postcss": "^8.2.9",
    "postcss-cli": "^11.0.1",
    "postcss-loader": "^8.2.1",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-webpack-plugin": "^5.1.0",
    "webpack": "^5.31.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@popperjs/core": "^2.9.2",
    "bootstrap": "^5.0.0-beta3",
    "core-js": "^3.10.0",
    "font-awesome": "^4.7.0",
    "gifsicle": "^7.0.1",
    "jquery": "^4.0.0"
  },
  "main": "postcss.config.js",
  "type": "commonjs",
  "homepage": "https://github.com/wbkd/webpack-starter#readme"
}
